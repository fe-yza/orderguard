# Copy to .env.local for local overrides. Baked into the client bundle at
# build time (NEXT_PUBLIC_* vars are inlined, not read at container start —
# see frontend/Dockerfile), so it must be set correctly at build/deploy
# time, not just at runtime.

# Base URL the browser uses to reach the OrderGuard API. Local dev default
# shown; in production (e.g. Vercel), set this to your deployed backend's
# public URL, and make sure that backend's ORDERGUARD_ALLOWED_ORIGINS
# includes this frontend's own deployed origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
