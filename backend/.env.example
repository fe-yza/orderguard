# Copy to .env and fill in real values for your environment. Never commit
# the real .env file (see .gitignore) — this file holds no real secrets,
# only placeholders and safe local-dev defaults.

# SQLAlchemy connection string. Local dev / docker-compose default shown;
# production should point at your real Postgres instance and use a
# non-default password.
ORDERGUARD_DATABASE_URL=postgresql+psycopg://orderguard:orderguard@localhost:5432/orderguard_dev

# Comma-separated list of origins allowed to call this API (CORS). Include
# the deployed frontend's real origin in production, e.g. a Vercel URL.
# Never set this to "*".
ORDERGUARD_ALLOWED_ORIGINS=http://localhost:3000

# Must be false in any environment reachable from the public internet —
# true returns exception tracebacks in API responses.
ORDERGUARD_DEBUG=false

# Per-client-IP budget for POST /simulations (the one endpoint expensive
# enough to need protecting from abuse — see api/rate_limit.py). Defaults
# comfortably cover normal interactive use.
ORDERGUARD_RATE_LIMIT_MAX_REQUESTS=20
ORDERGUARD_RATE_LIMIT_WINDOW_SECONDS=60
